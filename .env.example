# ============================================================
#                    MRS ORBIE CONFIG
# ============================================================

# =========================
# DISCORD BOT
# =========================
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
BOT_OWNER_ID=YOUR_DISCORD_USER_ID
BOT_PREFIX=$
Bot_Name=Mrs Orbie

# =========================
# SUPPORT / COMMUNITY
# =========================
SUPPORT_SERVER_URL=https://discord.gg/jBv4rU75
SUPPORT_SERVER_NAME=Mrs Orbie Support

# =========================
# BOT BRANDING
# =========================
BOT_DESCRIPTION=Your cute Quest Assistant
BOT_FOOTER=Mrs Orbie • Quest Assistant
DEVELOPER_NAME=ReejanOpYT

# =========================
# THEME
# =========================
# Preset name for your own reference. Colors below control the actual UI.
THEME=pink
THEME_PRIMARY=#ff69b4
THEME_SECONDARY=#ff9ed2
THEME_BACKGROUND=#0f0f14
THEME_CARD=#181820
THEME_CARD_SECONDARY=#20202b
THEME_TEXT=#ffffff
THEME_MUTED=#a9a9b3
THEME_SUCCESS=#57f287
THEME_WARNING=#fee75c
THEME_ERROR=#ed4245

# =========================
# DASHBOARD
# =========================
DASHBOARD_ENABLED=true
DASHBOARD_NAME=Mrs Orbie Dashboard
DASHBOARD_URL=http://YOUR_SERVER_IP:9190
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=9190
DASHBOARD_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DASHBOARD_AUTO_REFRESH=true
DASHBOARD_REFRESH_INTERVAL=5000

# =========================
# DATABASE
# =========================
MONGODB_URI=mongodb://127.0.0.1:27017/mrs_orbie
MONGODB_DB_NAME=mrs_orbie

# =========================
# QUEST SYSTEM
# =========================
QUEST_ENABLED=true
QUESTALL_ENABLED=true
AUTOQUEST_ENABLED=true
QUEST_COOLDOWN=45

# =========================
# PREMIUM
# =========================
PREMIUM_ENABLED=true
PREMIUM_7D_DAYS=7
PREMIUM_30D_DAYS=30
PREMIUM_LIFETIME=true
MAX_MAIN_ACCOUNTS=1
MAX_ALT_ACCOUNTS=1

# =========================
# ORBIE POINTS
# =========================
POINTS_ENABLED=true
POINTS_PER_INVITE=1
QUESTALL_PRICE=5
AUTOQUEST_3D_PRICE=15
PREMIUM_7D_PRICE=20
PREMIUM_LIFETIME_PRICE=50

# =========================
# PREMIUM KEYS
# =========================
PREMIUM_KEYS_ENABLED=true
PREMIUM_KEY_LENGTH=6
KEY_7D_REDEEM_WINDOW=7
KEY_30D_REDEEM_WINDOW=30
KEY_LIFETIME_REDEEM_WINDOW=30

# =========================
# LOGGING
# =========================
LOGGING_ENABLED=true
WEBHOOK_LOG_URL=

# =========================
# INVITE SYSTEM
# =========================
INVITE_TRACKING_ENABLED=true
INVITE_POINT_REWARD=true

# =========================
# EMOJIS
# =========================
# On every start the bot uploads any image in assets/emojis/ that is missing from
# its Application Emojis (names = file names). Existing emojis are never touched.
# The bot then uses those uploaded emojis everywhere. Run $emojis (owner) to re-sync.
EMOJI_AUTO_SYNC=true

# =========================
# FOOTER
# =========================
FOOTER_GIF=assets/mrs-orbie-footer.gif
FOOTER_ENABLED=true

# =========================
# PRESENCE
# =========================
PRESENCE_ENABLED=true
PRESENCE_TEXT=Questing with {guilds} servers
PRESENCE_TYPE=WATCHING

# =========================
# SECURITY
# =========================
OWNER_ONLY_COMMANDS=true
PREMIUM_KEY_ONE_TIME=true
DASHBOARD_OWNER_ONLY=true

# =========================
# DEBUG / NODE
# =========================
DEBUG=false
NODE_ENV=production
